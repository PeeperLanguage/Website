fn bump(values: &mut [3]i32) {      // changes the caller's array
    for value in values {
        value.* = value.* + 1;
    }
}

fn show(label: &str, values: &[]i32) {  // any length: a slice
    print(label);
    for value in values { print("", value.*); }
    println();
}

fn main() {
    let a = [3]i32{1, 2, 3};
    let mut c = a;                  // a copy: `a` stays as it is
    c[0] = 9;
    bump(&mut c);
    show("a:", &a);
    show("c:", &c);
    show("spread:", &[_]i32{a..., 0, a...});
}
